{
  "manifest_version": 2,
  "id": "worldcopyist.mai-secretary",
  "name": "麦麦小秘书",
  "version": "0.10.0",
  "description": "角色识别、主动聊天、自然语言定时任务、Azure 主题日报、AI 反霸凌、私有知识库与 DeepSeek 联网搜索。",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "bot"
    }
  },
  "author": {
    "name": "worldcopyist",
    "url": "https://github.com/worldcopyist"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/worldcopyist/maibot-mai-secretary"
  },
  "host_application": {
    "min_version": "1.3.7",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "999.999.999"
  },
  "dependencies": [
    {"type": "python_package", "name": "pypdf", "version_spec": ">=6.16,<7"},
    {"type": "python_package", "name": "httpx", "version_spec": ">=0.27,<1"},
    {"type": "python_package", "name": "Pillow", "version_spec": ">=11,<13"}
  ],
  "plugin_type": "management",
  "capabilities": [
    "chat.get_all_streams",
    "chat.open_session",
    "maisaka.proactive.trigger",
    "config.get",
    "message.get_recent",
    "message.get_by_time_in_chat",
    "llm.generate",
    "llm.embed",
    "send.text",
    "send.image"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
