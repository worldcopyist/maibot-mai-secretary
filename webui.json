{
  "schema_version": 2,
  "required_capabilities": ["custom_pages"],
  "workspace_title": "Mai Secretary",
  "pages": [
    {
      "id": "workbench",
      "title": "Mai Secretary · Module Workbench",
      "description": "Manage feature switches, relationships, follow-ups, and task delivery receipts. Set balance alerts in DeepSeek Web and Balance settings.",
      "placement": "workspace",
      "icon": "settings",
      "mode": "custom",
      "entry": "assets/workbench.html",
      "layout": "document",
      "queries": {"status": {"api": "secretary_workbench_status"}},
      "actions": {
        "feature_set": {"api": "secretary_feature_set", "parameters": {
          "action": {"type": "string", "required": true, "choices": ["enable", "disable", "reset"]},
          "feature": {"type": "string", "required": true, "max_length": 100}
        }},
        "relationship_set": {"api": "secretary_relationship_set", "parameters": {
          "action": {"type": "string", "required": true, "choices": ["familiar", "stranger", "reset"]},
          "account": {"type": "string", "required": true, "max_length": 50}
        }},
        "receipt_retry": {"api": "secretary_receipt_retry", "parameters": {
          "receipt_id": {"type": "string", "required": true, "max_length": 32}
        }},
        "followup_cancel": {"api": "secretary_followup_cancel", "parameters": {
          "followup_id": {"type": "string", "required": true, "max_length": 32}
        }}
      }
    },
    {
      "id": "tasks",
      "title": "Mai Secretary · Scheduled Tasks",
      "description": "View existing tasks and schedule one-time or recurring tasks for established chats.",
      "placement": "workspace",
      "icon": "list",
      "mode": "custom",
      "entry": "assets/tasks.html",
      "layout": "document",
      "queries": {
        "list": {"api": "secretary_tasks_list"},
        "streams": {"api": "secretary_tasks_streams"}
      },
      "actions": {
        "create": {"api": "secretary_tasks_create", "parameters": {
          "stream_id": {"type": "string", "required": true, "max_length": 200},
          "instruction": {"type": "string", "required": true, "max_length": 1000},
          "schedule": {"type": "string", "required": true, "choices": ["once", "daily", "weekly"]},
          "at": {"type": "string", "required": true, "max_length": 50},
          "weekdays": {"type": "string", "required": false, "max_length": 30},
          "timezone": {"type": "string", "required": false, "max_length": 80}
        }},
        "cancel": {"api": "secretary_tasks_cancel", "parameters": {
          "task_id": {"type": "string", "required": true, "max_length": 32}
        }}
      }
    },
    {
      "id": "timetable",
      "title": "Mai Secretary · Timetable",
      "description": "Experimental timetable import: supports only the developer's school's .xls export and schedules class reminders.",
      "placement": "workspace",
      "icon": "chart",
      "mode": "custom",
      "entry": "assets/timetable.html",
      "layout": "document",
      "queries": {
        "list": {"api": "secretary_timetable_list"},
        "streams": {"api": "secretary_tasks_streams"}
      },
      "actions": {
        "preview": {"api": "secretary_timetable_preview", "parameters": {
          "stream_id": {"type": "string", "required": true, "max_length": 200},
          "semester_start": {"type": "string", "required": true, "max_length": 10},
          "total_weeks": {"type": "integer", "required": true, "minimum": 1, "maximum": 25},
          "content": {"type": "string", "required": true, "max_length": 65536}
        }},
        "commit": {"api": "secretary_timetable_commit", "parameters": {
          "preview_id": {"type": "string", "required": true, "max_length": 24}
        }},
        "delete": {"api": "secretary_timetable_delete", "parameters": {
          "stream_id": {"type": "string", "required": true, "max_length": 200}
        }}
      }
    },
    {
      "id": "knowledge",
      "title": "Mai Secretary · Knowledge Base",
      "description": "Upload documents, paste text, and test retrieval. Configure chat access in the plugin settings.",
      "placement": "workspace",
      "icon": "database",
      "mode": "custom",
      "entry": "assets/knowledge.html",
      "layout": "document",
      "queries": {
        "list": {"api": "secretary_kb_list"},
        "mod_list": {"api": "secretary_mod_list"},
        "search": {"api": "secretary_kb_search", "parameters": {"query": {"type": "string", "required": true, "max_length": 500}}}
      },
      "actions": {
        "start": {"api": "secretary_kb_start", "parameters": {"filename": {"type": "string", "required": true, "max_length": 120}, "size": {"type": "integer", "required": true, "minimum": 1, "maximum": 8388608}}},
        "mod_start": {"api": "secretary_mod_start", "parameters": {"group_id": {"type": "string", "required": true, "max_length": 20}, "filename": {"type": "string", "required": true, "max_length": 120}, "size": {"type": "integer", "required": true, "minimum": 1, "maximum": 8388608}}},
        "append": {"api": "secretary_kb_append", "parameters": {"upload_id": {"type": "string", "required": true, "max_length": 32}, "sequence": {"type": "integer", "required": true, "minimum": 0}, "data": {"type": "string", "required": true, "max_length": 50000}}},
        "finish": {"api": "secretary_kb_finish", "parameters": {"upload_id": {"type": "string", "required": true, "max_length": 32}}},
        "add_text": {"api": "secretary_kb_add_text", "parameters": {"title": {"type": "string", "required": true, "max_length": 100}, "content": {"type": "string", "required": true, "max_length": 45000}}},
        "mod_add_text": {"api": "secretary_mod_add_text", "parameters": {"group_id": {"type": "string", "required": true, "max_length": 20}, "title": {"type": "string", "required": true, "max_length": 100}, "content": {"type": "string", "required": true, "max_length": 45000}}},
        "delete": {"api": "secretary_kb_delete", "parameters": {"document_id": {"type": "string", "required": true, "max_length": 32}}},
        "mod_delete": {"api": "secretary_mod_delete", "parameters": {"document_id": {"type": "string", "required": true, "max_length": 32}}},
        "rebuild": {"api": "secretary_kb_rebuild", "parameters": {"document_id": {"type": "string", "required": true, "max_length": 32}}}
      }
    }
  ]
}
