{
  "schema_version": 2,
  "required_capabilities": ["custom_pages"],
  "workspace_title": "麦麦小秘书",
  "pages": [
    {
      "id": "tasks",
      "title": "麦麦小秘书 · 定时任务",
      "description": "查看已创建的任务，并为现有聊天流手动安排单次或周期任务。",
      "placement": "workspace",
      "icon": "list",
      "mode": "custom",
      "entry": "assets/tasks.html",
      "layout": "document",
      "queries": {
        "list": {"api": "secretary_tasks_list"},
        "streams": {"api": "secretary_tasks_streams"}
      },
      "actions": {
        "create": {"api": "secretary_tasks_create", "parameters": {
          "stream_id": {"type": "string", "required": true, "max_length": 200},
          "instruction": {"type": "string", "required": true, "max_length": 1000},
          "schedule": {"type": "string", "required": true, "choices": ["once", "daily", "weekly"]},
          "at": {"type": "string", "required": true, "max_length": 50},
          "weekdays": {"type": "string", "required": false, "max_length": 30},
          "timezone": {"type": "string", "required": false, "max_length": 80}
        }},
        "cancel": {"api": "secretary_tasks_cancel", "parameters": {
          "task_id": {"type": "string", "required": true, "max_length": 32}
        }, "confirmation": "确定取消这项定时任务吗？"}
      }
    },
    {
      "id": "knowledge",
      "title": "麦麦小秘书 · 知识库",
      "description": "上传资料、粘贴文本并测试检索。聊天读取权限在插件配置页设置。",
      "placement": "workspace",
      "icon": "database",
      "mode": "custom",
      "entry": "assets/knowledge.html",
      "layout": "document",
      "queries": {
        "list": {"api": "secretary_kb_list"},
        "mod_list": {"api": "secretary_mod_list"},
        "search": {"api": "secretary_kb_search", "parameters": {"query": {"type": "string", "required": true, "max_length": 500}}}
      },
      "actions": {
        "start": {"api": "secretary_kb_start", "parameters": {"filename": {"type": "string", "required": true, "max_length": 120}, "size": {"type": "integer", "required": true, "minimum": 1, "maximum": 8388608}}},
        "mod_start": {"api": "secretary_mod_start", "parameters": {"group_id": {"type": "string", "required": true, "max_length": 20}, "filename": {"type": "string", "required": true, "max_length": 120}, "size": {"type": "integer", "required": true, "minimum": 1, "maximum": 8388608}}},
        "append": {"api": "secretary_kb_append", "parameters": {"upload_id": {"type": "string", "required": true, "max_length": 32}, "sequence": {"type": "integer", "required": true, "minimum": 0}, "data": {"type": "string", "required": true, "max_length": 50000}}},
        "finish": {"api": "secretary_kb_finish", "parameters": {"upload_id": {"type": "string", "required": true, "max_length": 32}}},
        "add_text": {"api": "secretary_kb_add_text", "parameters": {"title": {"type": "string", "required": true, "max_length": 100}, "content": {"type": "string", "required": true, "max_length": 45000}}},
        "mod_add_text": {"api": "secretary_mod_add_text", "parameters": {"group_id": {"type": "string", "required": true, "max_length": 20}, "title": {"type": "string", "required": true, "max_length": 100}, "content": {"type": "string", "required": true, "max_length": 45000}}},
        "delete": {"api": "secretary_kb_delete", "parameters": {"document_id": {"type": "string", "required": true, "max_length": 32}}, "confirmation": "确定永久删除这份文档和它的检索索引吗？"},
        "mod_delete": {"api": "secretary_mod_delete", "parameters": {"document_id": {"type": "string", "required": true, "max_length": 32}}, "confirmation": "确定删除这份群管敏感词文档吗？"},
        "rebuild": {"api": "secretary_kb_rebuild", "parameters": {"document_id": {"type": "string", "required": true, "max_length": 32}}}
      }
    }
  ]
}
